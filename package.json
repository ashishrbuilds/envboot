{
  "name": "envboot",
  "version": "0.1.4",
  "description": "Zero-runtime-dependency environment contract and validation tool for JavaScript and TypeScript projects",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "browser": "./dist/browser.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.mjs",
        "require": "./dist/browser.js"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "envboot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashishrbuilds/envboot.git"
  },
  "homepage": "https://github.com/ashishrbuilds/envboot#readme",
  "bugs": {
    "url": "https://github.com/ashishrbuilds/envboot/issues"
  },
  "keywords": [
    "envboot",
    "environment",
    "env",
    "validation",
    "config",
    "process.env",
    "import.meta.env",
    "contract",
    "boot",
    "startup",
    "cli"
  ],
  "author": "Ashish Ranjan",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@clack/prompts": "^0.7.0",
    "@types/node": "^20.11.0",
    "cac": "^6.7.14",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
